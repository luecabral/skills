#!/bin/bash
# A cada commit na main, pusha pro luecabral. É do GitHub que os plugins
# chegam pra quem instalou o marketplace (com auto-update ligado).
REPO_ROOT="$(git rev-parse --show-toplevel)"

GIT_DIR_PATH="$(git -C "$REPO_ROOT" rev-parse --git-dir)"
CUR_BRANCH="$(git -C "$REPO_ROOT" rev-parse --abbrev-ref HEAD)"
if [ -d "$GIT_DIR_PATH/rebase-merge" ] || [ -d "$GIT_DIR_PATH/rebase-apply" ] || [ -f "$GIT_DIR_PATH/MERGE_HEAD" ]; then
  echo "↺ rebase/merge em andamento — push adiado"
  exit 0
fi
if [ "$CUR_BRANCH" != "main" ]; then
  echo "↺ branch '$CUR_BRANCH' (não-main) — push só na main"
  exit 0
fi

if GIT_TERMINAL_PROMPT=0 git -C "$REPO_ROOT" push luecabral HEAD:main --quiet 2>/dev/null; then
  echo "✓ push luecabral"
else
  echo "⚠ push luecabral falhou (sem rede/credencial?) — rode 'git push luecabral main' depois"
fi
